{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh scripts/vercel-build.sh",
  "regions": ["sfo1"],
  "crons": [
    {
      "path": "/api/cron/purge-trash",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/publish-due",
      "schedule": "15 3 * * *"
    }
  ]
}
