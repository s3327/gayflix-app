// Database schema. Prisma Postgres in production, any Postgres locally.
// The connection string lives in prisma.config.ts (Prisma 7), not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Accounts (Better Auth) -------------------------------------------
// Generated by `npx auth@1.7.7 generate --config src/lib/auth.ts`.
// Re-run it after changing plugins in src/lib/auth.ts, then create a
// migration. `role` / `banned*` / `impersonatedBy` come from the admin
// plugin; RateLimit backs the database-stored rate limits.

model User {
  id               String         @id
  name             String
  email            String
  emailVerified    Boolean        @default(false)
  image            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  role             String?
  banned           Boolean?       @default(false)
  banReason        String?
  banExpires       DateTime?
  sessions         Session[]
  accounts         Account[]
  favorites        Favorite[]
  watchHistory     WatchHistory[]
  lists            MediaList[]
  reports          Report[]
  twoFactorEnabled Boolean?       @default(false)
  twoFactors       TwoFactor[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                String   @id
  expiresAt         DateTime
  token             String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  ipAddress         String?
  userAgent         String?
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy    String?
  /// Set only on sessions created by passing two-factor (src/lib/auth.ts).
  twoFactorVerified Boolean? @default(false)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// --- Library (favorites, history, lists) and reports --------------------
// Titles are stored as a snapshot (`entry`, the FavoriteEntry shape in
// src/lib/library-types.ts) because the catalog is still mock data. When
// the catalog moves into the database, `mediaId` becomes a relation.

model Favorite {
  userId    String
  mediaId   String
  entry     Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
  @@map("favorite")
}

model WatchHistory {
  userId    String
  mediaId   String
  entry     Json
  watchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
  @@index([userId, watchedAt])
  @@map("watch_history")
}

model MediaList {
  id        String     @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ListItem[]

  @@index([userId])
  @@map("media_list")
}

model ListItem {
  listId  String
  mediaId String
  entry   Json
  addedAt DateTime  @default(now())
  list    MediaList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([listId, mediaId])
  @@map("list_item")
}

/// "Report an issue" from the watch page. Guests are counted by a hash
/// of their IP address (never the address itself), signed-in users by
/// account.
model Report {
  id         String   @id @default(cuid())
  userId     String?
  ipHash     String?
  mediaId    String
  mediaTitle String
  reason     String
  details    String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@map("report")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}
