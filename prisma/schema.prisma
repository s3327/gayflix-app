// Database schema. Prisma Postgres in production, any Postgres locally.
// The connection string lives in prisma.config.ts (Prisma 7), not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Accounts (Better Auth) -------------------------------------------
// Generated by `npx auth@1.7.7 generate --config src/lib/auth.ts`.
// Re-run it after changing plugins in src/lib/auth.ts, then create a
// migration. `role` / `banned*` / `impersonatedBy` come from the admin
// plugin; RateLimit backs the database-stored rate limits.

model User {
  id               String         @id
  name             String
  email            String
  emailVerified    Boolean        @default(false)
  image            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  role             String?
  banned           Boolean?       @default(false)
  banReason        String?
  banExpires       DateTime?
  sessions         Session[]
  accounts         Account[]
  favorites        Favorite[]
  watchHistory     WatchHistory[]
  lists            MediaList[]
  reports          Report[]
  twoFactorEnabled Boolean?       @default(false)
  twoFactors       TwoFactor[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                String   @id
  expiresAt         DateTime
  token             String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  ipAddress         String?
  userAgent         String?
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy    String?
  /// Set only on sessions created by passing two-factor (src/lib/auth.ts).
  twoFactorVerified Boolean? @default(false)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// --- Catalog ------------------------------------------------------------
// Read through src/lib/catalog.ts. The public site only ever shows
// published titles; drafts are for the admin library.

enum MediaType {
  movie
  series

  @@map("media_type")
}

enum MediaStatus {
  draft
  published

  @@map("media_status")
}

/// A movie or a series. `id` is the slug in /movie/[id] and /series/[id].
model Media {
  id             String        @id
  type           MediaType
  status         MediaStatus   @default(draft)
  title          String
  year           Int
  /// As cards show it: "1h 52m" for a movie, "3 Seasons" for a series.
  /// The admin editor sets it from a movie's runtime, and from the seasons
  /// a series has episodes in.
  duration       String
  /// The first one is the main genre, the one cards show.
  genres         String[]
  country        String
  language       String
  synopsis       String        @default("")
  tagline        String?
  /// 0 to 5.
  rating         Float?
  /// Movies only.
  director       String?
  /// Series only.
  creator        String?
  cast           String[]
  tags           String[]
  releaseDate    DateTime?     @db.Date
  /// Movies only.
  runtimeMinutes Int?
  posterUrl      String
  /// 16:9, for the home page hero.
  backdropUrl    String?
  /// Tailwind gradient stops shown behind the poster.
  gradient       String?
  /// The home page hero shows the most recently updated featured title.
  /// The admin editor keeps it to one.
  featured       Boolean       @default(false)
  /// Views of all time (see MediaView). Trending ranks by the last 7
  /// days' views and breaks ties with this.
  viewCount      Int           @default(0)
  /// Set when the title was imported from TMDB: its address there,
  /// "movie/603" or "tv/1399" (TMDB numbers movies and series apart).
  /// Kept in the trash too, so the Import page never brings in a copy.
  tmdbId         String?       @unique
  /// "tt0133093". Set when an import matched the title on IMDb (through
  /// OMDb); an import that couldn't be checked has none.
  imdbId         String?       @unique
  /// Set while the title is in the admin panel's trash.
  trashedAt           DateTime?
  /// Remembered status before being moved to the trash, restored on restore.
  statusBeforeTrash   MediaStatus?
  /// Remembered featured flag before being moved to the trash.
  featuredBeforeTrash Boolean?     @default(false)
  backdropFocus       String?
  lockedFields        String[]      @default([])
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  episodes       Episode[]
  episodeRedirects EpisodeRedirect[]
  views          MediaView[]
  /// Movies only: a series' video is on its episodes.
  videoSources   VideoSource[]

  @@index([status, type, updatedAt])
  @@index([status, createdAt])
  @@index([status, publishedAt])
  @@index([status, type, publishedAt])
  @@map("media")
}

/// One episode of a series. `id` is the slug in /episode/[id].
model Episode {
  id            String        @id
  mediaId       String
  seasonNumber  Int
  episodeNumber Int
  title         String
  /// As shown: "42 min".
  duration      String
  airDate       DateTime?     @db.Date
  stillUrl      String?
  media         Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  videoSources  VideoSource[]

  @@unique([mediaId, seasonNumber, episodeNumber])
  @@map("episode")
}

model EpisodeRedirect {
  id                String   @id @default(cuid())
  mediaId           String
  oldSlug           String   @unique
  newSlug           String
  oldSeasonNumber   Int
  oldEpisodeNumber  Int
  newSeasonNumber   Int
  newEpisodeNumber  Int
  createdAt         DateTime @default(now())
  media             Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@map("episode_redirect")
}

enum VideoSourceKind {
  /// A player page shown in an iframe.
  embed
  /// An HLS stream: an .m3u8 playlist.
  hls
  /// A video file played as it is, such as .mp4 or .webm.
  file

  @@map("video_source_kind")
}

/// Where a movie or an episode plays from. Each source is one of the
/// player's server tabs, in `position` order; the watch pages only show
/// the ones that are on. The link's host must be in VIDEO_HOSTS
/// (src/lib/video-hosts.ts). Exactly one of mediaId (a movie) and
/// episodeId is set, which the migration's CHECK constraint enforces.
/// Changed only through src/lib/admin-video-actions.ts.
model VideoSource {
  id        String          @id @default(cuid())
  mediaId   String?
  episodeId String?
  /// The server tab's name: "Server 1", or the provider's.
  label     String
  kind      VideoSourceKind
  url       String
  position  Int
  enabled   Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  media     Media?          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  episode   Episode?        @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([mediaId, position])
  @@index([episodeId, position])
  @@map("video_source")
}

/// One view for Trending: someone pressed Play on a movie, or on an
/// episode of a series (counted for the series), on that UTC day. Each
/// viewer counts once per title per day. `viewer` is a keyed hash of the
/// account or the guest's IP address that changes every day, so rows
/// can't be traced to a person or linked across days (src/lib/views.ts).
/// Rows older than Trending's window are deleted.
model MediaView {
  mediaId String
  viewer  String
  day     DateTime @db.Date
  media   Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([mediaId, viewer, day])
  @@index([day, mediaId])
  @@map("media_view")
}

// --- Library (favorites, history, lists) and reports --------------------
// Titles are stored as a snapshot (`entry`, the FavoriteEntry shape in
// src/lib/library-types.ts), so saved titles keep showing even if one is
// later unpublished or removed. `mediaId` can also be an episode's id.

model Favorite {
  userId    String
  mediaId   String
  entry     Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
  @@map("favorite")
}

model WatchHistory {
  userId    String
  mediaId   String
  entry     Json
  watchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
  @@index([userId, watchedAt])
  @@map("watch_history")
}

model MediaList {
  id        String     @id @default(cuid())
  userId    String
  name      String
  /// Only the owner can see a list until they share it.
  isPublic  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ListItem[]

  @@index([userId])
  @@map("media_list")
}

model ListItem {
  listId  String
  mediaId String
  entry   Json
  addedAt DateTime  @default(now())
  list    MediaList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([listId, mediaId])
  @@map("list_item")
}

/// "Report an issue" from the watch page. Guests are counted by a hash
/// of their IP address (never the address itself), signed-in users by
/// account.
model Report {
  id         String    @id @default(cuid())
  userId     String?
  ipHash     String?
  mediaId    String
  mediaTitle String
  reason     String
  details    String?
  createdAt  DateTime  @default(now())
  /// Set when an admin closes the report in /admin/reports.
  resolvedAt DateTime?
  /// Email of the admin who closed it, as it was at the time.
  resolvedBy String?
  resolvedByUserId String?
  notes      String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@index([resolvedAt, createdAt])
  @@map("report")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}
