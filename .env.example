# Copy to .env.local for local overrides (never commit real values).

# --- Database (required) ---------------------------------------------------
# Prisma Postgres in production: use its direct connection string
# (postgres://...@db.prisma.io:5432/...). Locally, any Postgres works.
DATABASE_URL=postgresql://gayflix:gayflix@localhost:5432/gayflix

# --- Accounts (required) ---------------------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's public URL. Optional when SITE_URL (or Vercel's production
# domain) is the right value.
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in. The "Continue with Google" button only works once both
# are set. Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (required in production) ----------------------------------------
# Verification codes and password-reset links go out through Resend.
# Without a key, development prints emails to the server console and
# production refuses to send (the error shows in the server logs).
RESEND_API_KEY=
EMAIL_FROM="Gayflix <no-reply@your-domain.example>"

# --- Admin panel -----------------------------------------------------------
# Outer password gate for /admin — see src/lib/admin-auth.ts. Admin pages
# also require an account with the "admin" role (npm run make-admin).
# Unset in development: the gate is open (localhost:3000/admin).
# Unset in production: the admin panel is disabled (503), never public.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=

# --- Site --------------------------------------------------------------------
# Public origin used for sitemap.xml, robots.txt and metadata URLs. Read at
# build time. Optional on Vercel (the production domain is used by default).
SITE_URL=
