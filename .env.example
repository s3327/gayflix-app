# Copy to .env.local for local overrides (never commit real values).

# --- Database (required) ---------------------------------------------------
# Prisma Postgres in production: use its direct connection string
# (postgres://...@db.prisma.io:5432/...). Locally, any Postgres works.
DATABASE_URL=postgresql://gayflix:gayflix@localhost:5432/gayflix

# --- Accounts (required) ---------------------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's public URL. Optional when SITE_URL (or Vercel's production
# domain) is the right value.
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in. The "Continue with Google" button only works once both
# are set. Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (required in production) ----------------------------------------
# Verification codes and password-reset links go out through Resend.
# Without a key, development prints emails to the server console and
# production refuses to send (the error shows in the server logs).
RESEND_API_KEY=
EMAIL_FROM="Gayflix <no-reply@your-domain.example>"

# --- Admin panel -----------------------------------------------------------
# Optional extra password in front of /admin (see src/lib/admin-auth.ts).
# Admin pages require an account with a staff role (npm run make-admin).
# By default, two-factor authentication is optional for staff (can log in using password only).
# Set ADMIN_REQUIRE_2FA=true to mandate 2FA for all staff.
# Set both basic auth credentials for a second lock, or leave both empty.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=
ADMIN_REQUIRE_2FA=

# --- Scheduled background jobs -----------------------------------------------
# Secret authorization token for automated Vercel Cron endpoints (/api/cron/*).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Site --------------------------------------------------------------------
# Public origin used for sitemap.xml, robots.txt and metadata URLs. Read at
# build time. Optional on Vercel (the production domain is used by default).
SITE_URL=

# --- Import (optional) -------------------------------------------------------
# The admin Import page finds titles on TMDB and checks them against IMDb
# through OMDb (see "Importing titles" in docs/DEPLOYMENT.md). TMDB takes
# its API Read Access Token or its API key. Without OMDB_API_KEY, imports
# aren't checked against IMDb.
TMDB_API_KEY=
OMDB_API_KEY=
# Hosts posters and backdrops may come from, besides the sample catalog's,
# separated by commas. Read at build time. Imports need these two:
IMAGE_HOSTS=image.tmdb.org,m.media-amazon.com

# --- Video -------------------------------------------------------------------
# Hosts movies and episodes may play from, separated by commas. "*." allows
# every subdomain: player.example.com,*.b-cdn.net. An HLS stream needs its
# playlist's and its segments' hosts. See "Video" in docs/DEPLOYMENT.md.
VIDEO_HOSTS=

# --- Poster uploads (optional) ------------------------------------------------
# A Vercel Blob store's read-write token (Part 11 of docs/DEPLOYMENT.md).
# Vercel sets it when the store is connected to the project. Empty: the
# title editor takes image links only.
BLOB_READ_WRITE_TOKEN=

# --- Crash reports (optional) -------------------------------------------------
# A Sentry project's DSN (Part 10 of docs/DEPLOYMENT.md). Not a secret: it
# ends up in the site's JavaScript. Read at build time. Empty: no reports,
# and none of Sentry's code in the site.
NEXT_PUBLIC_SENTRY_DSN=
