# Copy to .env.local for local overrides (never commit real values).

# Admin panel (/admin) password gate — see src/lib/admin-auth.ts.
# Unset in development: the admin panel is open (localhost:3000/admin).
# Unset in production: the admin panel is disabled (503), never public.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=
