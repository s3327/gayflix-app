# Copy to .env.local for local overrides (never commit real values).

# --- Database (required) ---------------------------------------------------
# Locally, run Supabase's local stack (Docker): `npx supabase@3.2.0 start`,
# then copy the values from `npx supabase@3.2.0 status -o env` below
# (DB_URL, API_URL, PUBLISHABLE_KEY, SECRET_KEY). Mailpit, which catches
# the stack's emails, is at http://127.0.0.1:54424.
# Production is Supabase (Connect on the project's dashboard, Part 3 of
# docs/DEPLOYMENT.md):
#   DATABASE_URL     the transaction pooler string (port 6543), for the site
#   DIRECT_URL       the session pooler string (port 5432), for migrations
#   DATABASE_CA_CERT the project's SSL certificate (PEM), to verify the server
# A Supabase connection without DATABASE_CA_CERT is refused. Only on your
# own computer, DATABASE_TLS_INSECURE=1 connects encrypted but unverified
# instead (never on Vercel).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
DIRECT_URL=
DATABASE_CA_CERT=
DATABASE_TLS_INSECURE=

# --- Supabase Auth (accounts and sessions) ---------------------------------
# NEXT_PUBLIC_SUPABASE_URL is the stack's API_URL. The keys are server-only:
# never give them a NEXT_PUBLIC_ name.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Hashing (required in production) -------------------------------------
# Keys the one-way hashes of IP addresses (view counts, report and sign-in
# limits; src/lib/visitor.ts). Server-only. Generate with:
# openssl rand -base64 32
# Moving from Better Auth: set it to the old BETTER_AUTH_SECRET value, so
# hashes already stored keep matching (docs/SUPABASE_CUTOVER.md).
HASH_SECRET=

# Google sign-in and every account email (sign-up, password reset and
# email-change codes) are set up in Supabase itself, not here: the
# provider, SMTP (Resend) and the templates in supabase/templates. See
# Parts 4 and 8 of docs/DEPLOYMENT.md. Locally, Mailpit catches the emails.

# --- Admin panel -----------------------------------------------------------
# Optional extra password in front of /admin (see src/lib/admin-auth.ts).
# Admin pages require an account with a staff role (npm run make-admin).
# By default, two-factor authentication is optional for staff (can log in using password only).
# Set ADMIN_REQUIRE_2FA=true to mandate 2FA for all staff.
# Set both basic auth credentials for a second lock, or leave both empty.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=
ADMIN_REQUIRE_2FA=

# --- Scheduled background jobs -----------------------------------------------
# Secret authorization token for automated Vercel Cron endpoints (/api/cron/*).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Site --------------------------------------------------------------------
# Public origin used for sitemap.xml, robots.txt and metadata URLs. Read at
# build time. Optional on Vercel (the production domain is used by default).
SITE_URL=

# --- Import (optional) -------------------------------------------------------
# The admin Import page finds titles on TMDB and checks them against IMDb
# through OMDb (see "Importing titles" in docs/DEPLOYMENT.md). TMDB takes
# its API Read Access Token or its API key. Without OMDB_API_KEY, imports
# aren't checked against IMDb.
TMDB_API_KEY=
OMDB_API_KEY=
# Hosts posters and backdrops may come from, besides the sample catalog's,
# separated by commas. Read at build time. Imports need these two:
IMAGE_HOSTS=image.tmdb.org,m.media-amazon.com

# --- Video -------------------------------------------------------------------
# Hosts movies and episodes may play from, separated by commas. "*." allows
# every subdomain: player.example.com,*.b-cdn.net. An HLS stream needs its
# playlist's and its segments' hosts. See "Video" in docs/DEPLOYMENT.md.
VIDEO_HOSTS=

# --- Poster uploads (optional) ------------------------------------------------
# A Vercel Blob store's read-write token (Part 11 of docs/DEPLOYMENT.md).
# Vercel sets it when the store is connected to the project. Empty: the
# title editor takes image links only.
BLOB_READ_WRITE_TOKEN=

# --- Crash reports (optional) -------------------------------------------------
# A Sentry project's DSN (Part 10 of docs/DEPLOYMENT.md). Not a secret: it
# ends up in the site's JavaScript. Read at build time. Empty: no reports,
# and none of Sentry's code in the site.
NEXT_PUBLIC_SENTRY_DSN=
