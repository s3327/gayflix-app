{
  "name": "gayflix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "db:deploy": "node scripts/migrate.mjs",
    "make-admin": "node scripts/make-admin.mjs",
    "db:types": "kysely-codegen --dialect postgres --out-file src/lib/db-types.ts --include-pattern \"public.*\" --exclude-pattern \"{supabase_migrations.*,auth.*}\""
  },
  "dependencies": {
    "@sentry/nextjs": "11.15.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "@vercel/blob": "2.9.0",
    "hls.js": "1.7.4",
    "kysely": "0.29.9",
    "lucide-react": "0.427.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@next/env": "16.4.6",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "kysely-codegen": "0.20.0",
    "playwright-core": "1.65.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "overrides": {
    "undici": "6.29.1",
    "zod": "4.6.7"
  }
}
